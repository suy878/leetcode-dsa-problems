/**
 * Definition for a binary tree node.
 * public class TreeNode {
 *     int val;
 *     TreeNode left;
 *     TreeNode right;
 *     TreeNode() {}
 *     TreeNode(int val) { this.val = val; }
 *     TreeNode(int val, TreeNode left, TreeNode right) {
 *         this.val = val;
 *         this.left = left;
 *         this.right = right;
 *     }
 * }
 */
class Solution {
    public TreeNode searchBST(TreeNode root, int val) {
        traverse(root,val);
    }
    public TreeNode traverse(TreeNode node,int target){
        if(node==null){
            return null;
        }
    if(node.val==target){
     TreeNode fin=new TreeNode(node.val);
        fin.left.val;
        fin.right.val;
        return fin;
    }
    traverse(node.left,target);
    traverse(node.right,target);

    }
}
