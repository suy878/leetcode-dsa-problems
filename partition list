class Solution {
    public ListNode partition(ListNode head, int x) {
        // Create dummy heads for both chains
        ListNode list1 = new ListNode(0);
        ListNode list2 = new ListNode(0);
        
        // Pointers to track the current end of both chains
        ListNode list1_curr = list1;
        ListNode list2_curr = list2;

        ListNode curr = head;

        // Traverse the original list
        while (curr != null) {
            if (curr.val < x) {
                list1_curr.next = curr;   // Attach node to list1
                list1_curr = list1_curr.next; // Move list1 pointer forward
            } else {
                list2_curr.next = curr;   // Attach node to list2
                list2_curr = list2_curr.next; // Move list2 pointer forward
            }
            curr = curr.next; // CRITICAL: Move to the next node in the original list
        }
        
        // Connect the end of list1 to the beginning of list2 (skipping list2's dummy head)
        list1_curr.next = list2.next;
        
        // Cut off any remaining chain from the last element to prevent cycles
        list2_curr.next = null;

        // Return the head of the partitioned list (skipping list1's dummy head)
        return list1.next;
    }
}
